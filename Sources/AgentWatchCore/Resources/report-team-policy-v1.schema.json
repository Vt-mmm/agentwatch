{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentWatch local or managed report policy v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "organizationID", "revision", "owner", "timeZone", "employees", "allowGmail", "allowDrive", "allowScheduledDelivery", "allowNarrativeExport", "retentionDays", "effectiveFrom", "expiresAt"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "organizationID": {"type": "string"}, "revision": {"type": "integer", "minimum": 1},
    "owner": {"type": "string"}, "timeZone": {"type": "string"},
    "allowGmail": {"type": "boolean"}, "allowDrive": {"type": "boolean"},
    "allowScheduledDelivery": {"type": "boolean"}, "allowNarrativeExport": {"type": "boolean"},
    "retentionDays": {"type": "integer", "minimum": 7},
    "effectiveFrom": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"},
    "employees": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["employeeID", "googleAccountKeys", "recipients", "driveFolderIDs"],
      "properties": {
        "employeeID": {"type": "string"},
        "googleAccountKeys": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
        "recipients": {"type": "array", "items": {"type": "string"}},
        "driveFolderIDs": {"type": "array", "items": {"type": "string"}}
      }
    }}
  }
}
