<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Not "AgentWatch": Windows names are case-insensitive, and the CLI
         (agentwatch.exe, the broker Piagent runs) is published next to it. -->
    <AssemblyName>AgentWatchApp</AssemblyName>
    <RootNamespace>AgentWatch.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms is here for the notification-area icon only (TrayIcon.cs). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AgentWatch.Core/AgentWatch.Core.csproj" />
  </ItemGroup>
</Project>
